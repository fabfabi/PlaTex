#!/usr/bin/env bash

branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "$branch" = "main" ] || [ "$branch" = "dev" ]; then
  echo "Direct commits to main or dev are not allowed."
  echo "Create a feature branch before committing."
  exit 1
fi

if ! cargo fmt --all -- --check > /dev/null; then
  echo "Rust code is not formatted."
  echo "Run 'cargo fmt' and stage the changes before committing."
  exit 1
fi

exit 0
